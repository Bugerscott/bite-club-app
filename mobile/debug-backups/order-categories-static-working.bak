import React, { useMemo } from 'react';
import {
  FlatList,
  ScrollView,
  StyleSheet,
  Text,
  View,
  useWindowDimensions,
} from 'react-native';

import { ProductCard } from '../../src/components';
import { mockCategories, mockProducts } from '../../src/mocks';
import { resolveProductThumbnail } from '../../src/lib/productImages';
import { colors } from '../../src/theme';

type Product = (typeof mockProducts)[number];

type MenuRow =
  | {
      type: 'category';
      categoryId: string;
      label: string;
    }
  | {
      type: 'product';
      product: Product;
    };

export default function OrderScreen() {
  const { width } = useWindowDimensions();

  const cardWidth = Math.max(260, width - 40);

  const menuRows = useMemo<MenuRow[]>(() => {
    const rows: MenuRow[] = [];

    mockCategories.forEach((category) => {
      const products = mockProducts.filter(
        (product) =>
          product.categoryId === category.id &&
          product.available
      );

      if (products.length === 0) {
        return;
      }

      rows.push({
        type: 'category',
        categoryId: category.id,
        label: category.label,
      });

      products.forEach((product) => {
        rows.push({
          type: 'product',
          product,
        });
      });
    });

    return rows;
  }, []);

  return (
    <View style={styles.container}>
      <Text style={styles.title}>Pedir</Text>

      <FlatList
        data={menuRows}
        keyExtractor={(item) =>
          item.type === 'category'
            ? `category-${item.categoryId}`
            : `product-${item.product.id}`
        }
        initialNumToRender={5}
        maxToRenderPerBatch={4}
        windowSize={4}
        contentContainerStyle={styles.content}
        ListHeaderComponent={
          <View style={styles.categoryBar}>
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.categoryBarContent}
            >
              {mockCategories.map((category) => (
                <View
                  key={category.id}
                  style={styles.categoryChip}
                >
                  <Text style={styles.categoryChipText}>
                    {category.label}
                  </Text>
                </View>
              ))}
            </ScrollView>
          </View>
        }
        renderItem={({ item }) => {
          if (item.type === 'category') {
            return (
              <View style={styles.sectionHeader}>
                <Text style={styles.sectionTitle}>
                  {item.label}
                </Text>
              </View>
            );
          }

          return (
            <View style={styles.cardWrap}>
              <ProductCard
                product={item.product}
                imageSource={resolveProductThumbnail(
                  item.product.id
                )}
                cardWidth={cardWidth}
              />
            </View>
          );
        }}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: colors.background,
  },

  title: {
    paddingHorizontal: 20,
    paddingTop: 20,
    paddingBottom: 12,
    fontSize: 30,
    fontWeight: '700',
    color: colors.text,
  },

  content: {
    paddingBottom: 150,
  },

  categoryBar: {
    paddingBottom: 16,
  },

  categoryBarContent: {
    paddingHorizontal: 20,
    gap: 10,
  },

  categoryChip: {
    height: 40,
    justifyContent: 'center',
    paddingHorizontal: 18,
    borderRadius: 20,
    backgroundColor: '#F1F3F6',
    borderWidth: 1,
    borderColor: '#E1E6EC',
  },

  categoryChipText: {
    fontSize: 14,
    fontWeight: '600',
    color: '#53657D',
  },

  sectionHeader: {
    paddingHorizontal: 20,
    paddingTop: 20,
    paddingBottom: 12,
  },

  sectionTitle: {
    fontSize: 24,
    fontWeight: '700',
    color: '#53657D',
  },

  cardWrap: {
    paddingHorizontal: 20,
    marginBottom: 16,
  },
});
