{
  "expo": {
    "name": "Bite Club",
    "slug": "bite-club-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app/Bite-Club-_icon.png",
    "scheme": "biteclub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.biteclub.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/Bite-Club-_adaptive-icon.png",
        "monochromeImage": "./assets/app/Bite-Club-_monochrome-icon.png",
        "backgroundColor": "#E41A17"
      },
      "package": "com.biteclub.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/app/Bite-Club-_favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/Bite-Club-_splash-logo-static.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
